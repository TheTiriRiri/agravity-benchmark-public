<script>
  function setupTrackSwitch() {
    const tracks = ['classic', 'hard', 'brownfield'] as const;
    type Track = typeof tracks[number];

    const activeClasses: Record<Track, string[]> = {
      classic: ['bg-blue-600', 'text-white', 'shadow-sm'],
      hard: ['bg-amber-600', 'text-white', 'shadow-sm'],
      brownfield: ['bg-emerald-600', 'text-white', 'shadow-sm'],
    };
    const inactiveClasses = ['text-slate-400', 'hover:text-slate-200'];

    tracks.forEach((t) => {
      const btn = document.getElementById(`track-btn-${t}`);
      btn?.addEventListener('click', () => {
        tracks.forEach((other) => {
          const otherBtn = document.getElementById(`track-btn-${other}`);
          const otherPanel = document.getElementById(`track-panel-${other}`);
          if (other === t) {
            otherBtn?.setAttribute('aria-selected', 'true');
            otherBtn?.classList.remove(...inactiveClasses);
            otherBtn?.classList.add(...activeClasses[other]);
            otherPanel?.classList.remove('hidden');
          } else {
            otherBtn?.setAttribute('aria-selected', 'false');
            otherBtn?.classList.remove(...activeClasses[other]);
            otherBtn?.classList.add(...inactiveClasses);
            otherPanel?.classList.add('hidden');
          }
        });
      });
    });
  }

  // Setup on page load
  setupTrackSwitch();
</script>

