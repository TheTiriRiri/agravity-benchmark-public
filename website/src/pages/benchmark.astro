---
import Layout from '../layouts/Layout.astro';
import { marked } from 'marked';
import { readFileSync } from 'node:fs';
import { RUBRIC_ROWS } from '../../../scripts/lib/rubric';
import { HARD_RUBRIC_ROWS } from '../../../scripts/lib/hard-rubric';
import { BROWNFIELD_RUBRIC_ROWS, getRequiredRowMax } from '../../../scripts/lib/brownfield-rubric';
import { computeRubricStats, countLines, parseRunnerMeta } from '../components/benchmarkStats';

const title = 'Benchmark Task & Scoring Criteria — agrav-bench';
const description =
  'The exact prompt and evaluation criteria every Antigravity CLI model is graded against in agrav-bench across classic, hard, and brownfield tracks, scored by hidden API tests and a judge.';

const repoRoot = new URL('../../../', import.meta.url);

function readRepoFile(relativePath: string): string {
  try {
    return readFileSync(new URL(relativePath, repoRoot), 'utf8');
  } catch (error) {
    throw new Error(
      `benchmark.astro: cannot read ${relativePath} from the repo root. ` +
        'It is part of this repo and the page renders it verbatim — restore it ' +
        `before building. (${(error as Error).message})`
    );
  }
}

// Classic track
const promptClassicMd = readRepoFile('prompt.md');
const criteriaClassicMd = readRepoFile('benchmark/criteria.md');
const runnerClassicYaml = readRepoFile('benchmark/runner.yaml');

// Hard track
const promptHardMd = readRepoFile('tracks/console-hard/prompt.md');
const criteriaHardMd = readRepoFile('tracks/console-hard/benchmark/criteria.md');
const runnerHardYaml = readRepoFile('benchmark/runner-hard.yaml');

// Brownfield track
const promptBrownfieldMd = readRepoFile('tracks/brownfield/prompt.md');
const criteriaBrownfieldMd = readRepoFile('tracks/brownfield/benchmark/criteria.md');
const runnerBrownfieldYaml = readRepoFile('tracks/brownfield/benchmark/runner.yaml');

const promptClassicContent = await marked(promptClassicMd);
const criteriaClassicContent = await marked(criteriaClassicMd);

const promptHardContent = await marked(promptHardMd);
const criteriaHardContent = await marked(criteriaHardMd);

const promptBrownfieldContent = await marked(promptBrownfieldMd);
const criteriaBrownfieldContent = await marked(criteriaBrownfieldMd);

const classicStats = computeRubricStats(RUBRIC_ROWS);
const hardStats = computeRubricStats(HARD_RUBRIC_ROWS);
const brownfieldStats = computeRubricStats(BROWNFIELD_RUBRIC_ROWS);

const regressionMax = getRequiredRowMax(BROWNFIELD_RUBRIC_ROWS, 'Regression');
const changeSuiteMax = getRequiredRowMax(BROWNFIELD_RUBRIC_ROWS, 'Change suite');
const diffLocalityMax = getRequiredRowMax(BROWNFIELD_RUBRIC_ROWS, 'Diff locality');

const pts = (n: number) => `${n} ${n === 1 ? 'pt' : 'pts'}`;

const classicHiddenCount = RUBRIC_ROWS.filter((r) => r.scoredBy === 'hidden').length;
const classicHumanCount = RUBRIC_ROWS.filter((r) => r.scoredBy === 'human').length;

const classicRunner = parseRunnerMeta(runnerClassicYaml, 'benchmark/runner.yaml');
const hardRunner = parseRunnerMeta(runnerHardYaml, 'benchmark/runner-hard.yaml');
const brownfieldRunner = parseRunnerMeta(runnerBrownfieldYaml, 'tracks/brownfield/benchmark/runner.yaml');

const classicMeta = {
  ...classicRunner,
  promptLines: countLines(promptClassicMd),
  criteriaLines: countLines(criteriaClassicMd),
};

const hardMeta = {
  ...hardRunner,
  promptLines: countLines(promptHardMd),
  criteriaLines: countLines(criteriaHardMd),
};

const brownfieldMeta = {
  ...brownfieldRunner,
  promptLines: countLines(promptBrownfieldMd),
  criteriaLines: countLines(criteriaBrownfieldMd),
};
---

<Layout title={title} description={description}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
    
    <!-- Breadcrumb & Header -->
    <div class="mb-8">
      <nav class="flex items-center gap-2 text-sm text-slate-400 mb-3">
        <a href="/" class="hover:text-slate-200 transition-colors">Results</a>
        <span>/</span>
        <span class="text-slate-200">Benchmark Details</span>
      </nav>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">Benchmark Specification & Criteria</h1>
      <p class="mt-2 text-base sm:text-lg text-slate-300 max-w-3xl">
        The complete task contract, the full prompt, the scoring rubric and the scoring method for every Antigravity CLI track.
      </p>
    </div>

    <!-- Track Selector -->
    <div id="track-selector" class="mb-8">
      <div class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Choose a benchmark track:</div>
      <div role="tablist" class="inline-flex rounded-lg bg-slate-800 p-1 border border-slate-700 shadow-sm">
        <button
          id="track-btn-classic"
          role="tab"
          aria-selected="true"
          class="px-4 py-2 text-sm font-medium rounded-md transition-colors bg-blue-600 text-white shadow-sm"
        >
          Classic
        </button>
        <button
          id="track-btn-hard"
          role="tab"
          aria-selected="false"
          class="px-4 py-2 text-sm font-medium rounded-md transition-colors text-slate-400 hover:text-slate-200"
        >
          Hard
        </button>
        <button
          id="track-btn-brownfield"
          role="tab"
          aria-selected="false"
          class="px-4 py-2 text-sm font-medium rounded-md transition-colors text-slate-400 hover:text-slate-200"
        >
          Brownfield
        </button>
      </div>
    </div>

    <!-- Quick Navigation Pills -->
    <div class="sticky top-2 z-20 bg-slate-900/90 backdrop-blur-md p-2 rounded-xl border border-slate-700/80 shadow-xl mb-10 overflow-x-auto">
      <div class="flex items-center gap-2 text-sm whitespace-nowrap px-1">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 px-2">Jump to:</span>
        <a href="#key-specs-section" class="px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition font-medium text-xs sm:text-sm">
          📦 Task specification
        </a>
        <a href="#how-it-works-section" class="px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition font-medium text-xs sm:text-sm">
          ⚙️ How it works
        </a>
        <a href="#prompt-section" class="px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition font-medium text-xs sm:text-sm">
          📝 Prompt
        </a>
        <a href="#criteria-section" class="px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition font-medium text-xs sm:text-sm">
          🎯 Criteria
        </a>
        <a href="#judge-section" class="px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition font-medium text-xs sm:text-sm">
          ⚖️ Judge & version
        </a>
        <a href="#penalties" class="px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition font-medium text-xs sm:text-sm">
          ⚠️ Penalties
        </a>
      </div>
    </div>

    <!-- TRACK PANEL: CLASSIC -->
    <div id="track-panel-classic" class="track-panel">
      <!-- Key Specifications Summary Cards -->
      <div id="key-specs-section" class="mb-12 scroll-mt-24">
        <h2 class="text-xl font-bold text-slate-100 mb-4 flex items-center gap-2">
          <span>📦</span> Requirements summary (Classic track — Meridian Maintenance Console)
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="bg-slate-800/80 border border-slate-700/80 rounded-xl p-4 shadow-sm">
            <div class="text-xs font-semibold uppercase tracking-wider text-sky-400 mb-1">Backend</div>
            <div class="text-slate-100 font-bold text-base mb-1">FastAPI + Python 3.11</div>
            <p class="text-xs text-slate-300 leading-relaxed">
              In-memory store, uvicorn on port <code class="text-sky-300 font-mono bg-slate-900 px-1 py-0.5 rounded border border-slate-700">5100</code>. REST API under <code class="text-sky-300 font-mono bg-slate-900 px-1 py-0.5 rounded border border-slate-700">/api/v1/</code>.
            </p>
          </div>

          <div class="bg-slate-800/80 border border-slate-700/80 rounded-xl p-4 shadow-sm">
            <div class="text-xs font-semibold uppercase tracking-wider text-indigo-400 mb-1">Frontend</div>
            <div class="text-slate-100 font-bold text-base mb-1">React + Vite + Tailwind</div>
            <p class="text-xs text-slate-300 leading-relaxed">
              SPA on port <code class="text-sky-300 font-mono bg-slate-900 px-1 py-0.5 rounded border border-slate-700">5173</code>, proxy <code class="text-sky-300 font-mono bg-slate-900 px-1 py-0.5 rounded border border-slate-700">/api</code>. Dashboard, Schedule, Work Orders, Inventory.
            </p>
          </div>

          <div class="bg-slate-800/80 border border-slate-700/80 rounded-xl p-4 shadow-sm">
            <div class="text-xs font-semibold uppercase tracking-wider text-emerald-400 mb-1">Algorithm</div>
            <div class="text-slate-100 font-bold text-base mb-1">Maintenance Planner</div>
            <p class="text-xs text-slate-300 leading-relaxed">
              A deterministic algorithm: technician assignment, qualifications, time windows and spare-part reservations.
            </p>
          </div>

          <div class="bg-slate-800/80 border border-slate-700/80 rounded-xl p-4 shadow-sm">
            <div class="text-xs font-semibold uppercase tracking-wider text-amber-400 mb-1">Scoring</div>
            <div class="text-slate-100 font-bold text-base mb-1">{classicStats.max.toFixed(1)} Max Points</div>
            <p class="text-xs text-slate-300 leading-relaxed">
              {pts(classicStats.hidden)} from hidden automated tests + {pts(classicStats.auto)} auto + {pts(classicStats.judgeManual)} from judge review and human manual testing.
            </p>
          </div>
        </div>
      </div>

      <!-- How a run happens -->
      <div id="how-it-works-section" class="mb-12 scroll-mt-24">
        <h2 class="text-2xl font-bold text-slate-100 mb-4 flex items-center gap-2">
          <span>⚙️</span> How a run works (Classic)
        </h2>
        <div class="bg-slate-800/90 p-6 rounded-xl border border-slate-700/80 shadow-sm space-y-4">
          <p class="text-slate-300 text-base leading-relaxed">
            Each attempt is a single headless <strong>Antigravity CLI</strong> run in an isolated Docker container built from the pinned image. The model receives only the prompt and the specification.
          </p>
          <p class="text-slate-300 text-base leading-relaxed">
            The unit of comparison is the <strong class="text-white">(model, effort level)</strong> pair, e.g. <code class="text-sky-300 font-mono bg-slate-900 px-1.5 py-0.5 rounded border border-slate-700">--effort high</code>. Models of the same family are grouped on the results page.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 border-t border-slate-700">
            <div>
              <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold block mb-1">Agent CLI</span>
              <span class="text-slate-200 font-medium">Antigravity CLI{classicMeta.agyVersion ? ` ${classicMeta.agyVersion}` : ''}</span>
            </div>
            <div>
              <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold block mb-1">Attempts</span>
              <span class="text-slate-200 font-medium">{classicMeta.attempts ? `${classicMeta.attempts} per configuration` : 'as set in runner.yaml'}</span>
            </div>
            <div>
              <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold block mb-1">Rubric</span>
              <span class="text-slate-200 font-medium">{classicMeta.rubric}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Prompt Section -->
      <div id="prompt-section" class="mb-12 scroll-mt-24">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-2xl font-bold text-slate-100 flex items-center gap-2">
            <span>📝</span> Full task prompt (Classic)
          </h2>
          <span class="text-xs text-slate-400 bg-slate-800 px-2.5 py-1 rounded-full border border-slate-700 font-mono">
            prompt.md • {classicMeta.promptLines} lines
          </span>
        </div>

        <details open class="group bg-slate-800/90 rounded-xl border border-slate-700/80 shadow-sm overflow-hidden">
          <summary class="cursor-pointer select-none bg-slate-800 px-6 py-4 border-b border-slate-700 flex items-center justify-between hover:bg-slate-750 transition">
            <div class="flex items-center gap-3">
              <span class="text-sm font-semibold text-slate-200">Click to collapse / expand the full prompt</span>
            </div>
            <span class="text-xs text-slate-400 group-open:rotate-180 transition-transform duration-200">▼</span>
          </summary>
          
          <div class="p-6 sm:p-8 bg-slate-900/60 overflow-x-auto">
            <div class="markdown-body prose prose-invert prose-base max-w-none prose-slate">
              <Fragment set:html={promptClassicContent} />
            </div>
          </div>
        </details>
      </div>

      <!-- Criteria Section -->
      <div id="criteria-section" class="mb-12 scroll-mt-24">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-2xl font-bold text-slate-100 flex items-center gap-2">
            <span>🎯</span> Evaluation criteria (Classic)
          </h2>
          <span class="text-xs text-slate-400 bg-slate-800 px-2.5 py-1 rounded-full border border-slate-700 font-mono">
            criteria.md • {classicMeta.criteriaLines} lines
          </span>
        </div>

        <details open class="group bg-slate-800/90 rounded-xl border border-slate-700/80 shadow-sm overflow-hidden">
          <summary class="cursor-pointer select-none bg-slate-800 px-6 py-4 border-b border-slate-700 flex items-center justify-between hover:bg-slate-750 transition">
            <div class="flex items-center gap-3">
              <span class="text-sm font-semibold text-slate-200">Click to collapse / expand the rubric criteria</span>
            </div>
            <span class="text-xs text-slate-400 group-open:rotate-180 transition-transform duration-200">▼</span>
          </summary>
          
          <div class="p-6 sm:p-8 bg-slate-900/60 overflow-x-auto">
            <div class="markdown-body prose prose-invert prose-base max-w-none prose-slate">
              <Fragment set:html={criteriaClassicContent} />
            </div>
          </div>
        </details>
      </div>

      <!-- Judge Section -->
      <div id="judge-section" class="mb-12 scroll-mt-24">
        <h2 class="text-2xl font-bold text-slate-100 mb-4 flex items-center gap-2">
          <span>⚖️</span> Judge and rubric version (Classic)
        </h2>
        <div class="bg-slate-800/90 p-6 rounded-xl border border-slate-700/80 shadow-sm space-y-3">
          <p class="text-slate-300 text-base leading-relaxed">
            Attempts are scored by the judge <code class="text-sky-300 font-mono bg-slate-900 px-1.5 py-0.5 rounded border border-slate-700">{classicMeta.judge}</code> using the agy/claude assistant tooling, strictly by the rules of rubric <code class="text-sky-300 font-mono bg-slate-900 px-1.5 py-0.5 rounded border border-slate-700">{classicMeta.rubric}</code>.
          </p>
          <p class="text-slate-400 text-sm leading-relaxed">
            Results are directly comparable only under the same rubric version and judge. The {classicHiddenCount} hidden-test rows come entirely from automated contract tests, and the {classicHumanCount} UI rows are checked by a human on the running app.
          </p>
        </div>
      </div>
    </div>

    <!-- TRACK PANEL: HARD -->
    <div id="track-panel-hard" class="track-panel hidden">
      <!-- Key Specifications Summary Cards -->
      <div class="mb-12 scroll-mt-24">
        <h2 class="text-xl font-bold text-slate-100 mb-4 flex items-center gap-2">
          <span>📦</span> Requirements summary (Hard track — Meridian Maintenance Console)
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="bg-slate-800/80 border border-slate-700/80 rounded-xl p-4 shadow-sm">
            <div class="text-xs font-semibold uppercase tracking-wider text-sky-400 mb-1">Backend</div>
            <div class="text-slate-100 font-bold text-base mb-1">FastAPI + Python 3.11</div>
            <p class="text-xs text-slate-300 leading-relaxed">
              In-memory store, uvicorn on port <code class="text-sky-300 font-mono bg-slate-900 px-1 py-0.5 rounded border border-slate-700">5100</code>. REST API under <code class="text-sky-300 font-mono bg-slate-900 px-1 py-0.5 rounded border border-slate-700">/api/v1/</code>.
            </p>
          </div>

          <div class="bg-slate-800/80 border border-slate-700/80 rounded-xl p-4 shadow-sm">
            <div class="text-xs font-semibold uppercase tracking-wider text-indigo-400 mb-1">Frontend</div>
            <div class="text-slate-100 font-bold text-base mb-1">React + Vite + Tailwind</div>
            <p class="text-xs text-slate-300 leading-relaxed">
              SPA on port <code class="text-sky-300 font-mono bg-slate-900 px-1 py-0.5 rounded border border-slate-700">5173</code>, proxy <code class="text-sky-300 font-mono bg-slate-900 px-1 py-0.5 rounded border border-slate-700">/api</code>. Complex interactions, validation and E2E.
            </p>
          </div>

          <div class="bg-slate-800/80 border border-slate-700/80 rounded-xl p-4 shadow-sm">
            <div class="text-xs font-semibold uppercase tracking-wider text-amber-400 mb-1">Algorithm</div>
            <div class="text-slate-100 font-bold text-base mb-1">Advanced Planner</div>
            <p class="text-xs text-slate-300 leading-relaxed">
              Multi-technician crews, travel time, preemption and work-order splitting.
            </p>
          </div>

          <div class="bg-slate-800/80 border border-slate-700/80 rounded-xl p-4 shadow-sm">
            <div class="text-xs font-semibold uppercase tracking-wider text-amber-400 mb-1">Scoring</div>
            <div class="text-slate-100 font-bold text-base mb-1">{hardStats.max.toFixed(1)} Max Points</div>
            <p class="text-xs text-slate-300 leading-relaxed">
              {pts(hardStats.hidden)} from hidden automated and E2E tests + {pts(hardStats.auto)} auto + {pts(hardStats.judgeManual)} judge/human.
            </p>
          </div>
        </div>
      </div>

      <!-- How a run happens -->
      <div class="mb-12 scroll-mt-24">
        <h2 class="text-2xl font-bold text-slate-100 mb-4 flex items-center gap-2">
          <span>⚙️</span> How a run works (Hard)
        </h2>
        <div class="bg-slate-800/90 p-6 rounded-xl border border-slate-700/80 shadow-sm space-y-4">
          <p class="text-slate-300 text-base leading-relaxed">
            The Hard track extends the specification with high-complexity requirements: work-order splitting, preemption, technician crews and travel between sites.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 border-t border-slate-700">
            <div>
              <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold block mb-1">Agent CLI</span>
              <span class="text-slate-200 font-medium">Antigravity CLI{hardMeta.agyVersion ? ` ${hardMeta.agyVersion}` : ''}</span>
            </div>
            <div>
              <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold block mb-1">Attempts</span>
              <span class="text-slate-200 font-medium">{hardMeta.attempts ? `${hardMeta.attempts} per configuration` : 'as set in runner-hard.yaml'}</span>
            </div>
            <div>
              <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold block mb-1">Rubric</span>
              <span class="text-slate-200 font-medium">{hardMeta.rubric}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Prompt Section -->
      <div class="mb-12 scroll-mt-24">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-2xl font-bold text-slate-100 flex items-center gap-2">
            <span>📝</span> Full task prompt (Hard)
          </h2>
          <span class="text-xs text-slate-400 bg-slate-800 px-2.5 py-1 rounded-full border border-slate-700 font-mono">
            tracks/console-hard/prompt.md • {hardMeta.promptLines} lines
          </span>
        </div>

        <details open class="group bg-slate-800/90 rounded-xl border border-slate-700/80 shadow-sm overflow-hidden">
          <summary class="cursor-pointer select-none bg-slate-800 px-6 py-4 border-b border-slate-700 flex items-center justify-between hover:bg-slate-750 transition">
            <div class="flex items-center gap-3">
              <span class="text-sm font-semibold text-slate-200">Click to collapse / expand the full Hard prompt</span>
            </div>
            <span class="text-xs text-slate-400 group-open:rotate-180 transition-transform duration-200">▼</span>
          </summary>
          
          <div class="p-6 sm:p-8 bg-slate-900/60 overflow-x-auto">
            <div class="markdown-body prose prose-invert prose-base max-w-none prose-slate">
              <Fragment set:html={promptHardContent} />
            </div>
          </div>
        </details>
      </div>

      <!-- Criteria Section -->
      <div class="mb-12 scroll-mt-24">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-2xl font-bold text-slate-100 flex items-center gap-2">
            <span>🎯</span> Evaluation criteria (Hard)
          </h2>
          <span class="text-xs text-slate-400 bg-slate-800 px-2.5 py-1 rounded-full border border-slate-700 font-mono">
            tracks/console-hard/benchmark/criteria.md • {hardMeta.criteriaLines} lines
          </span>
        </div>

        <details open class="group bg-slate-800/90 rounded-xl border border-slate-700/80 shadow-sm overflow-hidden">
          <summary class="cursor-pointer select-none bg-slate-800 px-6 py-4 border-b border-slate-700 flex items-center justify-between hover:bg-slate-750 transition">
            <div class="flex items-center gap-3">
              <span class="text-sm font-semibold text-slate-200">Click to collapse / expand the Hard rubric criteria</span>
            </div>
            <span class="text-xs text-slate-400 group-open:rotate-180 transition-transform duration-200">▼</span>
          </summary>
          
          <div class="p-6 sm:p-8 bg-slate-900/60 overflow-x-auto">
            <div class="markdown-body prose prose-invert prose-base max-w-none prose-slate">
              <Fragment set:html={criteriaHardContent} />
            </div>
          </div>
        </details>
      </div>

      <!-- Judge Section -->
      <div class="mb-12 scroll-mt-24">
        <h2 class="text-2xl font-bold text-slate-100 mb-4 flex items-center gap-2">
          <span>⚖️</span> Judge and rubric version (Hard)
        </h2>
        <div class="bg-slate-800/90 p-6 rounded-xl border border-slate-700/80 shadow-sm space-y-3">
          <p class="text-slate-300 text-base leading-relaxed">
            Attempts are scored by the judge <code class="text-sky-300 font-mono bg-slate-900 px-1.5 py-0.5 rounded border border-slate-700">{hardMeta.judge}</code>, strictly by the rules of rubric <code class="text-sky-300 font-mono bg-slate-900 px-1.5 py-0.5 rounded border border-slate-700">{hardMeta.rubric}</code>.
          </p>
          <p class="text-slate-400 text-sm leading-relaxed">
            The {hardStats.hidden} automated points come from six hidden contract-test files (API contract, assignment, ordering, parts, crews and travel, splitting and preemption) and two Playwright E2E suites (flows, and layout and accessibility).
          </p>
        </div>
      </div>
    </div>

    <!-- TRACK PANEL: BROWNFIELD -->
    <div id="track-panel-brownfield" class="track-panel hidden">
      <!-- Key Specifications Summary Cards -->
      <div class="mb-12 scroll-mt-24">
