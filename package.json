{
  "name": "agrav-bench",
  "version": "1.0.0",
  "description": "Benchmark for Antigravity CLI models building a full-stack maintenance-planning app (FastAPI + React), scored by hidden API tests",
  "private": true,
  "type": "module",
  "scripts": {
    "run-matrix": "node --import tsx scripts/run-matrix.ts",
    "process-results": "node --import tsx scripts/process-results.ts",
    "process-results:hard": "node --import tsx scripts/process-results.ts -- --track hard",
    "process-results:brownfield": "node --import tsx scripts/process-results.ts -- --track brownfield",
    "screenshots": "node --import tsx scripts/take-screenshots.ts",
    "screenshots:hard": "node --import tsx scripts/take-screenshots.ts -- --track hard",
    "screenshots:brownfield": "node --import tsx scripts/take-screenshots.ts -- --track brownfield",
    "gate:reference": "node --import tsx scripts/reference-gate.ts",
    "gate:backend": "node --import tsx scripts/backend-gate.ts",
    "contract-tests": "node --import tsx scripts/contract-tests.ts",
    "serve-attempt": "node --import tsx scripts/serve-attempt.ts",
    "dev": "npm run process-results && cd website && npm run dev",
    "build": "npm run process-results && cd website && npm run build",
    "test": "node --test --import tsx \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && npm --prefix website run typecheck",
    "lint": "npm --prefix website run lint",
    "postinstall": "npm --prefix website ci --no-audit --fund=false",
    "fuzz:generate": "node --import tsx tracks/console-fuzz/benchmark/fuzz/generate.ts --write",
    "hard-fuzz:generate": "node --import tsx tracks/console-hard/benchmark/fuzz/generate.ts --write",
    "gate:fuzz": "node --import tsx scripts/fuzz-gate.ts",
    "gate:hard-fuzz": "node --import tsx scripts/hard-fuzz-gate.ts",
    "gate:hard-reference": "node --import tsx scripts/hard-reference-gate.ts",
    "gate:h-freeze": "node --import tsx scripts/gate-h-freeze.ts",
    "hard-seed:write": "node --import tsx tracks/console-hard/benchmark/context/hard-seed.ts --write",
    "contract-tests-hard": "node --import tsx scripts/contract-tests-hard.ts",
    "contract-tests-brownfield": "node --import tsx scripts/contract-tests-brownfield.ts",
    "contract-results:brownfield": "node --import tsx scripts/contract-results-brownfield.ts"
  },
  "keywords": [
    "benchmark",
    "llm",
    "antigravity"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.1",
    "csv-parse": "^7.0.2",
    "js-yaml": "^5.4.1",
    "playwright": "^1.62.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
