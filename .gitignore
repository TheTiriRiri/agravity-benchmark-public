# deps / build
node_modules/
dist/
**/.astro/
**/.wrangler/
*.tsbuildinfo

# secrets / local config
.env
.env.*
!.env_example

# agy drops a project stub into every workspace it touches
**/.antigravitycli/

# runner scratch (throwaway HOME copies, logs)
runs/
*.log

# single-instance lock held by a live run-matrix; released on exit
.run-matrix.lock

# a workspace run-matrix set aside before a rate-limit retry rather than
# deleting it (see setAsideWorkspace); the name cannot parse as an attempt dir,
# so no stage reads it — it is there to be looked at by hand and then removed
eval-attempts/*.rate-limited-*/

# a result writer killed between its write and its rename leaves its temp file
# (.contract-results.json.<pid>.<hex>.tmp); contract-tests removes dead writers' ones
eval-results/**/.*.tmp
tracks/**/eval-results/**/.*.tmp

# scoring scratch inside attempt dirs
eval-attempts/**/node_modules/
eval-attempts/**/dist/
# the model's own backend venv: an install artefact, never used for scoring
# (the scoring tools build a fresh one outside the attempt dir)
eval-attempts/**/.venv/
# the same install artefacts in a track's own eval-attempts/ (the rules above
# are anchored to the root one)
tracks/*/eval-attempts/*.rate-limited-*/
tracks/*/eval-attempts/**/node_modules/
tracks/*/eval-attempts/**/dist/
tracks/*/eval-attempts/**/.venv/

# generated by process-results / screenshots — committed on purpose, listed here for clarity
# website/src/data/results.json
# website/public/api/leaderboard.json
# website/public/screenshots/

# editors / os
.idea/
.vscode/
.DS_Store

# reference-backend venv built by `npm run gate:reference`
.cache/
__pycache__/

# the confidentiality test's forbidden terms, one per line — written by the
# operator, never committed, never read by an agent (test/confidentiality.test.ts).
# Separator and case variants of a multi-word term are matched (Zebra Widget also
# finds zebra_widget, zebra-widget, zebraWidget); a different spelling of the name
# — an abbreviation, a translation — needs its own line.
.confidential-terms

# Playwright output of the hard E2E suite (score-hard passes --output elsewhere; this catches manual runs)
tracks/console-hard/test-results/
